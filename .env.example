# ============================================================
# ORCA environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every variable has a working default in docker-compose.yml, so `.env` is only
# needed to supply secrets or to override hosts for a non-Docker run.
# ============================================================

# ---- LLM provider (Groq is the ONLY LLM provider) ----
# Used by the Query Understanding + Explanation agents. If blank, ORCA runs the
# whole pipeline deterministically (rule-based parser + i18n templates).
# 20B, not the 120B gpt-oss sibling: 120B was slow enough to regularly blow
# past the timeout below, and a failed/slow call gets retried
# LLM_MAX_RETRIES times at the FULL timeout each - 120B's worst case was
# minutes, not seconds, before falling back to the deterministic path.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
SESSION_MAX_TURNS=5

# ---- Datastores ----
# Inside `docker compose` the hostnames are the service names below.
# Running the backend directly on the host instead? Use localhost:
#   DATABASE_URL=postgresql+psycopg://orca:orca@localhost:5432/orca
#   REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://orca:orca@postgres:5432/orca
REDIS_URL=redis://redis:6379/0

# Credentials the postgres container is created with (compose also reads these).
# Local, non-secret placeholders - change before any non-local deployment.
POSTGRES_USER=orca
POSTGRES_PASSWORD=orca
POSTGRES_DB=orca

# ---- Secondary / supplementary data sources (needed in later phases) ----
# MOSDAC (ISRO) - secondary, non-blocking. Registration required.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
# Copernicus Marine - supplementary. Registration required.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
# WDPA / Protected Planet API token - protected-area layer ingest (later phase).
WDPA_API_TOKEN=

# Official IMD marine advisory (Sea Area Bulletin). Requires BOTH a key and a
# bearer token (api.imd.gov.in - neither is self-service on the public
# reference page); with either blank the advisory agent returns an explicit
# UNAVAILABLE result rather than a fabricated warning. Passed through by
# docker-compose.yml's backend service - see that file if you add these here
# and they still don't take effect.
IMD_API_KEY=
IMD_API_BEARER_TOKEN=

# GDACS global tropical-cyclone feed (Phase 11) - free, keyless, public. Only
# listed here for completeness / non-default overrides; the working defaults
# in app/core/config.py are enough for a normal run.
# GDACS_BASE_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
# GDACS_TIMEOUT_SECONDS=10
# GDACS_CACHE_TTL_SECONDS=1800
# GDACS_RELEVANCE_RADIUS_KM=800

# ---- Backend runtime (optional overrides) ----
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---- Authentication (Clerk) ----
# Clerk owns signup/login/password/session issuance - the frontend talks to
# Clerk directly and this backend only verifies the session token Clerk
# already issued. From your Clerk dashboard -> API Keys. With this blank,
# every protected request returns HTTP 500 rather than accepting an
# unverifiable token.
CLERK_SECRET_KEY=

# ---- Supabase (app-side user profile storage only) ----
# The ONLY thing Supabase stores for ORCA: a small `profiles` row keyed by
# the Clerk user id (see backend/sql/supabase_profiles.sql - run that once in
# your Supabase project's SQL editor). ORCA's own self-hosted Postgres/PostGIS
# above (DATABASE_URL) is untouched. From your Supabase project -> Settings ->
# API. Use the service_role key here (backend-only, never the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Phase 4: data agents (all have working defaults) ----
# Open-Meteo is the MVP live source; no API key required.
OPENMETEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPENMETEO_TIMEOUT_SECONDS=10
OPENMETEO_RETRIES=1
OPENMETEO_FORECAST_HOURS=48
# Redis cache (bucketed keys). If Redis is down the agents just skip the cache.
CACHE_ENABLED=true
CACHE_COORD_DECIMALS=2
WEATHER_CACHE_TTL_SECONDS=3600
MARINE_CACHE_TTL_SECONDS=3600
# GIS backend: auto (PostGIS if reachable, else offline) | postgis | offline
GIS_BACKEND=auto

# ---- Phase 9: environmental data (SST + chlorophyll-a) - all optional, no secrets ----
# SST rides the existing Open-Meteo Marine call - nothing to configure.
# Chlorophyll-a is fetched from NOAA CoastWatch ERDDAP (public, no auth).
OCEANCOLOR_ENABLED=true
OCEANCOLOR_NOAA_ERDDAP_URL=https://coastwatch.noaa.gov/erddap
OCEANCOLOR_NOAA_CHL_DATASET=noaacwNPPVIIRSchlaDaily
OCEANCOLOR_NOAA_CHL_VARIABLE=chlor_a
# INCOIS ERDDAP is an OPTIONAL secondary. Leave blank unless a real dataset id
# has been verified. It is only tried when BOTH url and dataset are set, always
# with normal TLS verification (never verify=False).
OCEANCOLOR_INCOIS_ERDDAP_URL=
OCEANCOLOR_INCOIS_CHL_DATASET=
OCEANCOLOR_INCOIS_CHL_VARIABLE=chlor_a
# Optional PEM file that completes the INCOIS TLS chain (path, not a secret).
OCEANCOLOR_INCOIS_CA_BUNDLE=
# Kept short (interactive-demo band, same as OPENMETEO_TIMEOUT_SECONDS /
# IMD_TIMEOUT_SECONDS) with no retry, since the CHL chain can issue several
# sequential ERDDAP calls (axis discovery + data, x2 NOAA datasets) - an
# unreachable NOAA host must fail fast, not stall /query.
OCEANCOLOR_TIMEOUT_SECONDS=10
OCEANCOLOR_RETRIES=0
OCEANCOLOR_CACHE_TTL_SECONDS=32400
OCEANCOLOR_CACHE_MAX_AGE_SECONDS=86400
# A chlorophyll composite older than this (vs the decision time) is rejected.
OCEANCOLOR_CHL_MAX_AGE_SECONDS=864000
# When true, agents may fall back to clearly-labelled DEMO data (never LIVE).
AGENT_DEMO_FALLBACK=false

# ---- Frontend ----
# Backend base URL as reached from the browser.
VITE_API_URL=http://localhost:8000
# Clerk's publishable key (safe to expose to the browser - from your Clerk
# dashboard -> API Keys, the "Publishable key", NOT the secret key above).
VITE_CLERK_PUBLISHABLE_KEY=
