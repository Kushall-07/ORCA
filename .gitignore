# ================================
# ORCA - Git Ignore
# ================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# FastAPI / Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / React
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.vite/

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Backend environment files
backend/.env
backend/.env.*
!backend/.env.example

# IDE / Editors
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Jupyter
.ipynb_checkpoints/

# Python packaging
*.egg-info/
.eggs/
*.whl

# Local databases
*.db
*.sqlite
*.sqlite3

# Large / downloaded data
data/raw/*
data/processed/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/demo/.gitkeep

# Local generated outputs
outputs/
reports/generated/

# Secrets / credentials
*.pem
*.key
credentials.json
service-account*.json