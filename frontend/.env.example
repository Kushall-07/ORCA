# Base URL of the ORCA FastAPI backend, as reached from the browser.
# Local dev (Vite on the host):   http://localhost:8000
# docker compose:                 http://localhost:8000  (backend port is published)
VITE_API_URL=http://localhost:8000

# Clerk's publishable key (safe to expose to the browser - from your Clerk
# dashboard -> API Keys, the "Publishable key", NOT the secret key, which
# only the backend's CLERK_SECRET_KEY should ever hold).
VITE_CLERK_PUBLISHABLE_KEY=
